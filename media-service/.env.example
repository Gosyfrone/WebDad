# Media Service — config propre au service
# Local (make run) : copier en .env → MINIO_ENDPOINT=localhost:9000
# Docker (compose) : ce fichier est lu via `env_file:` (par le service ET par
#                    le conteneur minio) ; MINIO_ENDPOINT est surchargé par le
#                    nom du conteneur (minio:9000).

PORT=8087
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)
LOG_LEVEL=info  # debug|info|warn|error — JSON en release, texte sinon

# ─── MinIO (stockage objet) ───────────────────────────────────────
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD sont lus par l'image minio (conteneur
# minio) ET par le service Go (identifiants d'accès). Un seul .env pour les deux.
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=webdad
MINIO_ROOT_PASSWORD=CHANGE_ME  # openssl rand -hex 16
MINIO_USE_SSL=false
MINIO_BUCKET=breezy-media

# ─── Caps de taille d'upload (octets) — UTILISATEURS NON-ADMIN ────
# Défaut : 5 Mo pour tous les types (image / vidéo / blob chiffré E2EE),
# aligné sur le plus petit cap d'un service de référence (X.com : photo 5 Mo).
# Les ADMINISTRATEURS ne sont PAS plafonnés (bypass dans le code) → rien à régler.
# Décommenter pour surcharger le cap des non-admins.
# MEDIA_MAX_IMAGE_BYTES=5242880
# MEDIA_MAX_VIDEO_BYTES=5242880
# MEDIA_MAX_BLOB_BYTES=5242880

# JWT_SECRET n'est PAS ici : il vient du .env racine (variable partagée).
