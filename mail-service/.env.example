# Mail Service — config propre au service
# Local (make run) : copier en .env.
# Docker (compose) : ce fichier est lu via `env_file:`.

PORT=8089
GIN_MODE=debug

# ─── SMTP (Gmail) ─────────────────────────────────────────────────
# Laisser VIDE en dev → transport "console" : les e-mails sont loggés sur
# stdout (make logs-mail), on clique le lien sans dépendre de Gmail.
#
# Pour envoyer réellement : renseigner avec un App Password Google
# (https://myaccount.google.com/apppasswords) — PAS le mot de passe du compte.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=ton.compte@gmail.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx   (App Password 16 caractères)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse "From" affichée (défaut = SMTP_USER si vide).
SMTP_FROM=

# MAIL_INTERNAL_SECRET n'est PAS ici : il vient du .env racine
# (secret partagé entre auth-service et mail-service).
