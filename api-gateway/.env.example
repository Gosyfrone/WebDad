# API Gateway — config propre au service
# Local (make run) : copier en .env → URLs en localhost
# Docker (compose) : ce fichier est lu via `env_file:`,
#                    les URLs sont surchargées par les noms de conteneurs.

PORT=8080
GIN_MODE=debug

# Origines autorisées en CORS (front). Liste séparée par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── URLs des services backend ────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
PROFIL_SERVICE_URL=http://localhost:8083
POST_SERVICE_URL=http://localhost:8084
MESSAGE_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
MEDIA_SERVICE_URL=http://localhost:8087

# JWT_SECRET n'est PAS ici : il vient du .env racine (variable partagée).
