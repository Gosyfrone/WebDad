# Report Service — config propre au service
# Local (make run)   : copier en .env → MONGO_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      MONGO_HOST est surchargé par le nom du conteneur.

PORT=8090
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)
LOG_LEVEL=info  # debug|info|warn|error — JSON en release, texte sinon

# ─── MongoDB ──────────────────────────────────────────────────────
# MONGO_INITDB_* sont lus par l'image mongo (conteneur mongo-report).
# Le service Go construit l'URI à partir de HOST/PORT/USER/PASSWORD/DB :
#   mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=webdad
# Générer une vraie valeur avec : openssl rand -hex 16
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=webdad_report

# JWT_SECRET n'est PAS ici : il vient du .env racine (partagé entre services).
