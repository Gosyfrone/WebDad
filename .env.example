# ──────────────────────────────────────────────────────────────────
# WebDad — variables TRANSVERSES (toute l'application)
# Copier en .env (`cp .env.example .env`) puis renseigner les secrets.
# ⚠️ Ne JAMAIS commit le fichier .env (déjà dans .gitignore).
#
# Ce fichier ne contient QUE le partagé entre services.
# La config propre à un service vit dans <service>/.env
# (docker-compose va la chercher via `env_file:`).
# ──────────────────────────────────────────────────────────────────

# ─── JWT (partagé : auth signe, gateway/user/profil/post vérifient) ─
# DOIT être identique partout, sinon les tokens ne sont pas validés.
JWT_SECRET=replace_with_a_long_random_value_at_least_32_chars
# Access token court : le front catche le 401 et rafraîchit (refresh token).
JWT_EXPIRY=15m
# Refresh token (cookie httpOnly) : durée de la session avant reconnexion.
REFRESH_EXPIRY=24h

# ─── Frontend ─────────────────────────────────────────────────────
# URL publique de l'API Gateway (lue côté navigateur — joignable depuis l'hôte)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Traduction automatique des posts (route BFF Next /api/translate).
# Par défaut, le frontend utilise LibreTranslate public ; pour la prod/démo fiable,
# brancher une instance dédiée ou une URL compatible LibreTranslate.
TRANSLATION_API_URL=https://libretranslate.de/translate
# Optionnel selon le fournisseur / l'instance LibreTranslate.
TRANSLATION_API_KEY=
