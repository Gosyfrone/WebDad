# ──────────────────────────────────────────────────────────────────
# WebDad — variables TRANSVERSES (toute l'application)
# Copier en .env (`cp .env.example .env`) puis renseigner les secrets.
# ⚠️ Ne JAMAIS commit le fichier .env (déjà dans .gitignore).
#
# Ce fichier ne contient QUE le partagé entre services.
# La config propre à un service vit dans <service>/.env
# (docker-compose va la chercher via `env_file:`).
#
# Générer les secrets : openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────

# ─── JWT (partagé : auth signe, gateway/user/profil/post vérifient) ─
# DOIT être identique partout, sinon les tokens ne sont pas validés.
JWT_SECRET=CHANGE_ME  # openssl rand -hex 32
# Access token court : le front catche le 401 et rafraîchit (refresh token).
JWT_EXPIRY=15m
# Refresh token (cookie httpOnly) : durée de la session avant reconnexion.
REFRESH_EXPIRY=24h

# ─── Événements internes (post-service → notification-service) ──────
# Secret partagé qui authentifie les appels serveur-à-serveur d'émission
# d'événements (POST /internal/events). N'est JAMAIS exposé au client.
INTERNAL_EVENT_SECRET=CHANGE_ME  # openssl rand -hex 32

# ─── E-mail (auth-service → mail-service) ──────────────────────────
# Secret partagé qui authentifie l'appel serveur-à-serveur d'envoi d'e-mail
# (POST /internal/send vers mail-service). N'est JAMAIS exposé au client.
MAIL_INTERNAL_SECRET=CHANGE_ME  # openssl rand -hex 32
# URL publique du frontend : auth-service l'utilise pour les LIENS des e-mails
# (vérification, reset, bienvenue admin) → APP_BASE_URL/verify-email?token=…
# DOIT être joignable depuis une boîte mail : jamais localhost en prod (sinon les
# liens sont cassés dans Gmail et l'e-mail part en spam).
# Dev : http://localhost:3000 — Prod : https://breezy.philippeluu.fr
APP_BASE_URL=http://localhost:3000
# URL ABSOLUE du logo affiché dans les e-mails. Découplée d'APP_BASE_URL pour
# rester PUBLIQUE même en dev local (sinon l'<img> pointe vers localhost → logo
# cassé dans la boîte du destinataire). Si non défini, retombe sur
# APP_BASE_URL/logo_breezy.png. Pointer vers le domaine public dans TOUS les envs.
MAIL_LOGO_URL=https://breezy.philippeluu.fr/logo_breezy.png

# ─── Frontend ─────────────────────────────────────────────────────
# URL publique de l'API Gateway (lue côté navigateur — joignable depuis l'hôte)
# Dev : http://localhost:8080 — Prod : http://<IP_VPS>:8080 ou https://api.breezy.example.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Traduction automatique des posts (route BFF Next /api/translate).
# Par défaut, le frontend utilise LibreTranslate public ; pour la prod/démo fiable,
# brancher une instance dédiée ou une URL compatible LibreTranslate.
TRANSLATION_API_URL=https://libretranslate.de/translate
# Optionnel selon le fournisseur / l'instance LibreTranslate.
TRANSLATION_API_KEY=
