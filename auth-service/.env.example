# Auth Service — config propre au service
# Local (make run)   : copier en .env → DB_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      DB_HOST est surchargé par le nom du conteneur.

PORT=8081
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)

# ─── PostgreSQL ───────────────────────────────────────────────────
# Les noms POSTGRES_* sont lus à la fois par le service Go
# ET par l'image postgres (conteneur postgres-auth).
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=webdad_auth
POSTGRES_USER=webdad
POSTGRES_PASSWORD=CHANGE_ME  # openssl rand -hex 16

# ─── Vérification d'e-mail (mail-service) ─────────────────────────
# URL du mail-service appelé en best-effort (hors gateway).
# Local (make run) : http://localhost:8089 ; en Docker, compose surcharge
# avec http://mail-service:8089.
MAIL_SERVICE_URL=http://localhost:8089
# NB : MAIL_INTERNAL_SECRET (secret partagé) et APP_BASE_URL (base des liens
# dans les e-mails) viennent du .env RACINE — ne pas les redéfinir ici.
# Sans MAIL_INTERNAL_SECRET, l'envoi d'e-mails devient un no-op loggé.

# ─── Seed admin ───────────────────────────────────────────────────
# Si true, le service crée un compte admin au démarrage (idempotent).
# SEED_ADMIN_PASSWORD devient alors REQUIS (aucun mot de passe en dur).
# Dev : false — Prod : true avec SEED_ADMIN_PASSWORD renseigné.
SEED_DEFAULT_ADMIN=false
SEED_ADMIN_EMAIL=admin@breezy.example.com
# SEED_ADMIN_PASSWORD=CHANGE_ME

# ─── Création de compte par un admin ──────────────────────────────
# true (DEV/LOCAL) = court-circuite la vérification d'e-mail des comptes créés
# par un admin → connexion directe au mot de passe temporaire (pratique quand
# l'envoi de mail réel se fait en ligne). false (PROD) = vérification d'e-mail
# obligatoire via le lien reçu, qui ouvre la session vers le feed.
ADMIN_CREATE_AUTO_VERIFY=false

# ─── OAuth OIDC — Login with Google ───────────────────────────────
# L'échange code→tokens et la vérification de l'ID token se font côté serveur.
# Base du redirect URI front ; le service ajoute /auth/callback/<provider>.
# (Redirect Google à déclarer : http://localhost:3000/auth/callback/google)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Google — credentials OAuth (console Google Cloud → OAuth 2.0 Client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
