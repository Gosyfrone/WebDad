# Post Service — config propre au service
# Local (make run)   : copier en .env → MONGO_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      MONGO_HOST est surchargé par le nom du conteneur.

PORT=8084
GIN_MODE=debug

# Services consultés pour filtrer les posts selon la visibilité du profil.
USER_SERVICE_URL=http://localhost:8082
PROFIL_SERVICE_URL=http://localhost:8083
INTERNAL_SECRET=

# ─── MongoDB ──────────────────────────────────────────────────────
# MONGO_INITDB_* sont lus par l'image mongo (conteneur mongo-post).
# Le service Go construit l'URI à partir de HOST/PORT/USER/PASSWORD/DB :
#   mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=webdad
MONGO_INITDB_ROOT_PASSWORD=change_me_in_local_too
MONGO_INITDB_DATABASE=webdad_post

# ─── Signets (bookmarks) ──────────────────────────────────────────
# Fenêtre glissante de « rafale » : un clic court qui suit le précédent signet
# de moins de cette durée range automatiquement dans la dernière playlist ;
# au-delà, le serveur redemande la playlist (format durée Go, ex. 5m, 10m).
BOOKMARK_SESSION_WINDOW=5m
