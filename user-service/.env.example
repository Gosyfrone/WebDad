# User Service — config propre au service
# Local (make run)   : copier en .env → DB_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      DB_HOST est surchargé par le nom du conteneur.

PORT=8082
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)
LOG_LEVEL=info  # debug|info|warn|error — JSON en release, texte sinon

# ─── Règles métier ────────────────────────────────────────────────
# Délai minimal entre deux changements de username (format durée Go,
# ex. "168h" = 7 jours). Vide ou 0 = désactivé (le timestamp de changement
# est tout de même enregistré, prêt à servir le jour où on active la règle).
# USERNAME_CHANGE_COOLDOWN=168h

# ─── PostgreSQL ───────────────────────────────────────────────────
# Les noms POSTGRES_* sont lus à la fois par le service Go
# ET par l'image postgres (conteneur postgres-user).
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=webdad_user
POSTGRES_USER=webdad
# Générer une vraie valeur avec : openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
