# Message Service — config propre au service
# Local (make run)   : copier en .env → MONGO_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      MONGO_HOST est surchargé par le nom du conteneur.

PORT=8085
GIN_MODE=debug

# Origines autorisées pour l'upgrade WebSocket (mêmes que la CORS du gateway).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────
# MONGO_INITDB_* sont lus par l'image mongo (conteneur mongo-message).
# Le service Go construit l'URI à partir de HOST/PORT/USER/PASSWORD/DB :
#   mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=webdad
MONGO_INITDB_ROOT_PASSWORD=change_me_in_local_too
MONGO_INITDB_DATABASE=webdad_message

# JWT_SECRET n'est PAS ici : il vient du .env racine (variable partagée).
