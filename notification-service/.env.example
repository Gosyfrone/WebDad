# Notification Service — config propre au service
# Local (make run)   : copier en .env → MONGO_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      MONGO_HOST est surchargé par le nom du conteneur.

PORT=8086
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)
LOG_LEVEL=info  # debug|info|warn|error — JSON en release, texte sinon

# Origines autorisées pour l'upgrade WebSocket (mêmes que la CORS du gateway).
# Dev : http://localhost:3000 — Prod : http://<IP_VPS>:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base du user-service, pour résoudre les mentions (@handle → user_id).
# En stack Docker, surchargé par compose vers http://user-service:8082.
USER_SERVICE_URL=http://localhost:8082

# ─── MongoDB ──────────────────────────────────────────────────────
# MONGO_INITDB_* sont lus par l'image mongo (conteneur mongo-notification).
# Le service Go construit l'URI à partir de HOST/PORT/USER/PASSWORD/DB :
#   mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=webdad
# Générer une vraie valeur avec : openssl rand -hex 16
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=webdad_notification

# JWT_SECRET et INTERNAL_EVENT_SECRET ne sont PAS ici : ils viennent du .env
# racine (variables partagées entre services).
