# Profil Service — config propre au service
# Local (make run)   : copier en .env → MONGO_HOST=localhost
# Docker (compose)   : ce fichier est lu via `env_file:`,
#                      MONGO_HOST est surchargé par le nom du conteneur.

PORT=8083
GIN_MODE=debug  # release en prod (surchargé par docker-compose.prod.yml)

# ─── Règles métier ────────────────────────────────────────────────
# Délai minimal entre deux changements de display_name (format durée Go,
# ex. "168h" = 7 jours). Vide ou 0 = désactivé (le timestamp de changement
# est tout de même enregistré, prêt à servir le jour où on active la règle).
# DISPLAY_NAME_CHANGE_COOLDOWN=168h

# ─── MongoDB ──────────────────────────────────────────────────────
# MONGO_INITDB_* sont lus par l'image mongo (conteneur mongo-profil).
# Le service Go construit l'URI à partir de HOST/PORT/USER/PASSWORD/DB :
#   mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=webdad
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME  # openssl rand -hex 16
MONGO_INITDB_DATABASE=webdad_profil
